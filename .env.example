# Copy to .env for local development. Values are public (they end up in the browser bundle);
# row-level security in Supabase protects the data. Never put a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: Azure Application Insights. Leave empty to send no telemetry (default for local dev).
VITE_APPINSIGHTS_CONNECTION_STRING=
